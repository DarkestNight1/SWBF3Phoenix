-			p_LookupTable = new std::unordered_map<FNVHash, std::string>();
+			char buffer[MAX_PATH] = {};
+			DWORD len = GetModuleFileNameA(self, buffer, MAX_PATH);
+			if (len > 0 && len < MAX_PATH)
+			{
+				std::string full(buffer, len);
+				size_t slash = full.find_last_of(std::string(1, (char)92) + (char)47);
+				if (slash != std::string::npos)
