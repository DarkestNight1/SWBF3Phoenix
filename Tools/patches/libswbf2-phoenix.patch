-
-		std::ifstream csv(LOOKUP_CSV_PATH);
-		for (std::string line; std::getline(csv, line); )
+#else
+		Dl_info info;
+		if (dladdr(reinterpret_cast<void*>(&ResolveLookupCsvPath), &info) && info.dli_fname != nullptr)
 		{
-			// Exclude carriage return for Unix compatibility
-			if (!line.empty() && line.back() == 0x0D)
+			std::string full(info.dli_fname);
+			size_t slash = full.find_last_of('/');
+			if (slash != std::string::npos)
 			{
-				line.pop_back();
+				moduleDir = full.substr(0, slash + 1);
 			}
+		}
+#endif
 
-			p_LookupTable->emplace(Hash(line.c_str()), line);
+		if (!moduleDir.empty())
+		{
+			std::string beside = moduleDir + "lookup.csv";
+			std::ifstream probe(beside);
+			if (probe.good())
+			{
+				return beside;
+			}
 		}
+
+		return std::string(LOOKUP_CSV_PATH);
 	}
+
+	const std::unordered_map<FNVHash, std::string>& FNV::LookupTable()
+	{
+		static const std::unordered_map<FNVHash, std::string> table = []
+		{
+			std::unordered_map<FNVHash, std::string> t;
+
+			const std::string path = ResolveLookupCsvPath();
+			std::ifstream csv(path);
+			if (!csv.good())
+			{
+				// Worth saying out loud: an empty table is not a crash, it is
+				// every hashed name silently failing to resolve.
+				LOG_WARN("FNV lookup table not found at \"{}\" - hashed names will not resolve.", path);
+			}
+			for (std::string line; std::getline(csv, line); )
+			{
+				// Exclude carriage return for Unix compatibility
+				if (!line.empty() && line.back() == 0x0D)
+				{
+					line.pop_back();
+				}
+
+				t.emplace(Hash(line.c_str()), line);
+			}
+			return t;
+		}();
+
+		return table;
+	}
+
+	// Kept so existing callers still link. Touching the table is enough to
+	// force its construction; there is nothing to free afterwards.
+	void FNV::ReadLookupTable()
+	{
