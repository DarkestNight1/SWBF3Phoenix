From 06006d06e2137e8f003d12d5bc1d3403c95e566a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 8 Aug 2026 22:30:47 -0400
Subject: [PATCH 2/2] Repair the terrain material's dangling shader reference

HDRPTerrain.mat pointed at shader GUID 24be0fd07876c8c428ffc50674bd9dc7, which
exists nowhere in the project - not in Assets, not in the HDRP package. The
terrain shadergraph is c4323b53411a5aa42bb4148d9e652b56. With the reference
unresolved, Unity substitutes its error shader and every outdoor map renders
magenta ground.

Also harden the fallback in MaterialLoader. Testing shader == null does not
catch this case: an unresolved reference yields Hidden/InternalErrorShader, not
null, so the previous guard never fired and nothing was logged. Check for the
error shader by name and fall back to the lit material with an explicit
message.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 .../Resources/HDRPTerrain.mat                 |  2 +-
 LVLImport/Loaders/MaterialLoader.cs           | 36 ++++++++++++++-----
 2 files changed, 28 insertions(+), 10 deletions(-)

diff --git a/LVLImport/ConversionAssets/Resources/HDRPTerrain.mat b/LVLImport/ConversionAssets/Resources/HDRPTerrain.mat
index 5af8f96..b665737 100644
--- a/LVLImport/ConversionAssets/Resources/HDRPTerrain.mat
+++ b/LVLImport/ConversionAssets/Resources/HDRPTerrain.mat
@@ -8,7 +8,7 @@ Material:
   m_PrefabInstance: {fileID: 0}
   m_PrefabAsset: {fileID: 0}
   m_Name: HDRPTerrain
-  m_Shader: {fileID: -6465566751694194690, guid: 24be0fd07876c8c428ffc50674bd9dc7, type: 3}
+  m_Shader: {fileID: -6465566751694194690, guid: c4323b53411a5aa42bb4148d9e652b56, type: 3}
   m_ShaderKeywords: _DISABLE_SSR_TRANSPARENT _NORMALMAP_TANGENT_SPACE
   m_LightmapFlags: 4
   m_EnableInstancingVariants: 0
diff --git a/LVLImport/Loaders/MaterialLoader.cs b/LVLImport/Loaders/MaterialLoader.cs
index abad3cf..1e688a7 100644
--- a/LVLImport/Loaders/MaterialLoader.cs
+++ b/LVLImport/Loaders/MaterialLoader.cs
@@ -54,23 +54,41 @@ public class MaterialLoader : Loader
                 _DefaultTerrainMaterial = new UMaterial(Shader.Find(DefaultTerrainSTDShader));
             }
 
-            // A missing Resources entry, or a terrain shadergraph that failed
-            // to compile, yields a material with no shader - which Unity draws
-            // as solid magenta. That looked like a texturing bug on the ground
-            // of every outdoor map with no hint as to the cause, so say it
-            // plainly and fall back to the lit material the models already use.
-            if (_DefaultTerrainMaterial == null || _DefaultTerrainMaterial.shader == null)
+            // Terrain renders magenta when the material's shader cannot be
+            // resolved. Testing for a null shader is NOT enough and was the
+            // reason an earlier version of this guard never fired: when a
+            // material references a shader GUID that no asset provides, Unity
+            // substitutes Hidden/InternalErrorShader rather than leaving the
+            // reference null. That is exactly what happened here - the terrain
+            // material pointed at a shader GUID present nowhere in the project
+            // - and it renders as the familiar magenta with nothing logged.
+            if (!IsUsable(_DefaultTerrainMaterial))
             {
                 Debug.LogError(
-                    "Terrain material unavailable (missing Resources asset or the terrain " +
-                    "shader failed to compile) - terrain would render magenta. Falling back " +
-                    "to the default lit material; terrain layer blending will be missing.");
+                    "Terrain material has no usable shader (unresolved shader reference, or " +
+                    "the terrain shadergraph failed to compile) - terrain would render " +
+                    "magenta. Falling back to the default lit material; terrain layer " +
+                    "blending will be missing.");
                 _DefaultTerrainMaterial = new UMaterial(GetDefaultMaterial());
             }
         }
         return _DefaultTerrainMaterial;
     }
 
+    /// <summary>
+    /// Whether a material will actually render, rather than showing Unity's
+    /// magenta error colour. Covers the three distinct failures: the asset
+    /// itself missing, a null shader, and - the one that is easy to miss - an
+    /// unresolved shader reference, which Unity fills in with
+    /// Hidden/InternalErrorShader instead of null.
+    /// </summary>
+    static bool IsUsable(UMaterial mat)
+    {
+        return mat != null
+            && mat.shader != null
+            && mat.shader.name != "Hidden/InternalErrorShader";
+    }
+
     UMaterial GetDefaultTransparentMaterial()
     {
         if (_DefaultHDRPTransparentMaterial == null)
