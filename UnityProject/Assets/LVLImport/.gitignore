#!LVLImport/
Flail.cs
Grab.cs

# ignore build asset bundles
/AssetBundles

Assets/AssetStoreTools*

# Visual Studio 2015 cache directory
.vs/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.meta

# Unity3D Generated File On Crash Reports
sysinfo.txt

# Builds
*.apk
*.unitypackage

# Mac/Linux ignores
*.so
*.dylib
*.dll
*.DS_Store
*.sh

# LibSWBF2 logs
*.log


# Asset Ignores
*.fbx
*.tga

# explicitly allow .obj files (wavefront 3D object)
!*.obj
# These two .meta files are content, not Unity scratch. The shader graph
# references BlendTerrainLayers.hlsl by GUID, so letting Unity regenerate the
# meta breaks the reference and the terrain renders purple - which is the
# "Known problems" entry in the repo README.
!LVLImport/ConversionAssets/BlendTerrainLayers.hlsl.meta
!LVLImport/ConversionAssets/SWBFTerrain.shader.meta
GitRepoAssets/
